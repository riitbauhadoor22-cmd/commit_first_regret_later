# Copy this file to .env and fill in the real values. Never commit .env.
# Gmail used to send login codes. App Password: myaccount.google.com/apppasswords (needs 2-Step Verification on)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Later: speech-to-text, text-to-speech, translation
OPENAI_API_KEY=
# Database. Default (empty) = SQLite file backend/app.db. Production: the PostgreSQL URL from Supabase or Neon,
# e.g. postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///./app.db
