# Copy this file to .env and fill in the real values. Never commit .env.
# Gmail used to send login codes. App Password: myaccount.google.com/apppasswords (needs 2-Step Verification on)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Later: speech-to-text, text-to-speech, translation
OPENAI_API_KEY=
# Database. Default (empty) = SQLite file backend/app.db. Production: the PostgreSQL URL from Supabase or Neon,
# e.g. postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_URL=
# Financial insights (Groq, free tier: console.groq.com/keys). Empty key = the button says "not set up"; the maths still works.
GROQ_API_KEY=
# Empty = openai/gpt-oss-20b
GROQ_MODEL=
# Limits (empty = the default in brackets): AI requests per user per day [5], seconds between requests [60],
# reply tokens [1000], prompt characters [6000], seconds to wait for Groq [25]
AI_DAILY_LIMIT=
AI_COOLDOWN_SECONDS=
AI_MAX_OUTPUT_TOKENS=
AI_MAX_INPUT_CHARS=
AI_TIMEOUT_SECONDS=
# WhatsApp login codes for accounts registered with a phone only (Twilio WhatsApp sandbox, free trial).
# Console → Messaging → Try it out → Send a WhatsApp message. Each tester sends "join <code>" to the sandbox number.
# Empty = phone-only accounts get "WhatsApp codes aren't set up yet" (email login still works).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The sandbox number shown in the console, e.g. +14155238886
TWILIO_WHATSAPP_FROM=
