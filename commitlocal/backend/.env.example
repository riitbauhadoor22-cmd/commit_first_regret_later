# Copy this file to .env and fill in the real values. Never commit .env.
# "production" on Render (Secure cookies, HSTS, no /docs); empty = development. ENV also works.
APP_ENV=
# Gmail used to send login codes. App Password: myaccount.google.com/apppasswords (needs 2-Step Verification on)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Brevo (brevo.com, free plan) sends login codes through its HTTP API. Set it on Render (free plan blocks SMTP).
# Empty BREVO_API_KEY = Gmail above is used (local development).
BREVO_API_KEY=
# Sender address (must be a verified sender in Brevo) and name (empty = Pennyworth)
EMAIL_FROM=
EMAIL_FROM_NAME=
# Later: speech-to-text, text-to-speech, translation
OPENAI_API_KEY=
# Database. Default (empty) = SQLite file backend/app.db. Production: the PostgreSQL URL from Supabase or Neon,
# e.g. postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_URL=
# Financial insights (Groq, free tier: console.groq.com/keys). Empty key = the button says "not set up"; the maths still works.
GROQ_API_KEY=
# Empty = openai/gpt-oss-20b
GROQ_MODEL=
# "📷 Scan bill" (Add expense) uses GROQ_API_KEY too. Vision model (Groq only has PREVIEW vision models; check
# console.groq.com/docs/vision). Empty = qwen/qwen3.8-27b. Photos are never stored or logged.
GROQ_VISION_MODEL=
# Bill scans per user per day (empty = 10) and seconds between two scans (empty = 10)
BILL_SCAN_DAILY_LIMIT=
BILL_SCAN_COOLDOWN_SECONDS=
# Limits (empty = the default in brackets): AI requests per user per day [5], seconds between requests [60],
# reply tokens [1000], prompt characters [6000], seconds to wait for Groq [25]
AI_DAILY_LIMIT=
AI_COOLDOWN_SECONDS=
AI_MAX_OUTPUT_TOKENS=
AI_MAX_INPUT_CHARS=
AI_TIMEOUT_SECONDS=
# DEMO ONLY: true = the login code is also shown on the code screen ("DEMO MODE - code: 123456").
# Must stay false in the real app (anyone with the password could log in without the inbox).
DEMO_SHOW_OTP=false
# DEMO ONLY: the budget plan pretends today is this date (YYYY-MM-DD), e.g. the 1st of next month to show the
# monthly result, streak and suggestion. Empty = the real date. Ignored when APP_ENV=production.
DEMO_TODAY=
