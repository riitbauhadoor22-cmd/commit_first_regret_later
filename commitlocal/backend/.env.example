# Copy this file to .env and fill in the real values. Never commit .env.
# Gmail used to send login codes. App Password: myaccount.google.com/apppasswords (needs 2-Step Verification on)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Later: speech-to-text, text-to-speech, translation
OPENAI_API_KEY=
# Database. Default (empty) = SQLite file backend/app.db. Production: the PostgreSQL URL from Supabase or Neon,
# e.g. postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_URL=
# Financial insights (Groq, free tier: console.groq.com/keys). Empty key = the button says "not set up"; the maths still works.
GROQ_API_KEY=
# Empty = openai/gpt-oss-20b
GROQ_MODEL=
# Limits (empty = the default in brackets): AI requests per user per day [5], seconds between requests [60],
# reply tokens [1000], prompt characters [6000], seconds to wait for Groq [25]
AI_DAILY_LIMIT=
AI_COOLDOWN_SECONDS=
AI_MAX_OUTPUT_TOKENS=
AI_MAX_INPUT_CHARS=
AI_TIMEOUT_SECONDS=
# WhatsApp login codes (Meta WhatsApp Cloud API). Setup steps: README.md "WhatsApp login codes".
# Set WHATSAPP_ENABLED to true once the values below are filled. Anything else = WhatsApp off
# (phone-only accounts then get "WhatsApp codes are unavailable right now"; email codes still work).
WHATSAPP_ENABLED=false
# Temporary token (lasts ~24 h) from WhatsApp > API Setup, or a permanent System User token (Business Settings)
WHATSAPP_ACCESS_TOKEN=
# "Phone number ID" shown in WhatsApp > API Setup (not the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
# Name of your approved AUTHENTICATION template (with a "copy code" button), e.g. login_code
WHATSAPP_TEMPLATE_NAME=
# The template's language code
WHATSAPP_TEMPLATE_LANG=en_US
# Optional: Graph API version, empty = v27.0
WHATSAPP_API_VERSION=
# DEMO ONLY: true = the login code is also shown on the code screen ("DEMO MODE - code: 123456").
# Must stay false in the real app (anyone with the password could log in without the phone / inbox).
DEMO_SHOW_OTP=false
